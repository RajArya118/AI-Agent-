# ==============================================================================
# BuildPilot AI & AI Assistant — Production Environment Configuration Template
# ==============================================================================

# 1. Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Database Configuration
# MongoDB Atlas Connection String (Production Render / Cloud)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://buildpilot_user:your_password@cluster0.mongodb.net/buildpilot?retryWrites=true&w=majority
# Local MongoDB fallback connection string (Local Development)
MONGODB_URL=mongodb://localhost:27017/buildpilot

# SQLite Relational Database (Conversations & Document metadata)
DATABASE_URL=sqlite:///./ai_assistant.db

# 3. Backend Server & Network Configuration (Render)
PORT=8000
HOST=0.0.0.0
# Comma-separated list of allowed origins. Supports Vercel preview domains via CORS regex.
CORS_ORIGINS=https://buildpilot-ai.vercel.app,http://localhost:5173,http://localhost:3000

# 4. Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=10

# 5. Frontend Production Configuration (Set on Vercel)
# Format: https://<your-render-backend-name>.onrender.com/api
VITE_API_BASE_URL=https://buildpilot-backend.onrender.com/api
